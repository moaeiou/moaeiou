# Maintainer: MoAEIOU

pkgname=rayburst
pkgver_gh=4.0.0-beta.6
pkgver=4.0.0_beta.6
pkgrel=1
pkgdesc="Redefining the open-source download manager"
arch=(x86_64)
url="https://github.com/AnInsomniacy/rayburst"
license=(MIT)
depends=(
    cairo
    gdk-pixbuf2
    gtk3
    hicolor-icon-theme
    libappindicator
    libsoup3
    webkit2gtk-4.1
)
source=(
    "https://raw.githubusercontent.com/AnInsomniacy/rayburst/refs/heads/main/LICENSE"
    "$pkgname-$pkgver-x86_64.deb::$url/releases/download/v$pkgver_gh/Rayburst_${pkgver_gh}_amd64.deb"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
    local debfile="$pkgname-$pkgver-$CARCH.deb"
    ar x "$debfile" data.tar.gz
}

package() {
    tar -xf data.tar.gz -C "$pkgdir"
    sed -i '/^Categories=/c\Categories=Network;FileTransfer;' \
        "$pkgdir/usr/share/applications/Rayburst.desktop"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
