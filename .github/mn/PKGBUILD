# Maintainer: MoAEIOU

pkgname=motrix-next-bin
_pkgver_gh=3.9.8-beta.8
pkgver=3.9.8_beta.8
pkgrel=1
pkgdesc="A full-featured download manager rebuilt with Tauri 2, Vue 3, and Rust (tracks latest upstream release, including pre-releases)"
arch=(x86_64)
url="https://github.com/AnInsomniacy/motrix-next"
license=(MIT)
depends=(
    cairo
    gdk-pixbuf2
    gtk3
    hicolor-icon-theme
    libappindicator
    libsoup3
    webkit2gtk-4.1
)
source=(
    "LICENSE"
    "$pkgname-$pkgver-x86_64.deb::$url/releases/download/v$_pkgver_gh/MotrixNext_${_pkgver_gh}_amd64.deb"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
    # The .deb is an ar archive; pull data.tar.gz out of it so package()
    # can extract it directly. makepkg does not do this step for us.
    local debfile="$pkgname-$pkgver-$CARCH.deb"
    ar x "$debfile" data.tar.gz
}

package() {
    # Extract the contents of data.tar.gz into the pkgdir itself
    tar -xf data.tar.gz -C "$pkgdir"

    # Fix empty Categories so KDE launcher displays the app
    sed -i '/^Categories=/c\Categories=Network;FileTransfer;' \
        "$pkgdir/usr/share/applications/MotrixNext.desktop"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
