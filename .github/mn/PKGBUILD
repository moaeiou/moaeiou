# Maintainer: MoAEIOU

pkgname=motrix-next
pkgver_gh=3.9.9-beta.1
pkgver=3.9.9_beta.1
pkgrel=1
pkgdesc="A full-featured download manager rebuilt with Tauri 2, Vue 3, and Rust (tracks latest upstream release, including pre-releases)"
arch=(x86_64)
url="https://github.com/AnInsomniacy/motrix-next"
license=(MIT)
depends=(
    cairo
    gdk-pixbuf2
    gtk3
    hicolor-icon-theme
    libappindicator
    libsoup3
    webkit2gtk-4.1
)
source=(
    "LICENSE"
    "$pkgname-$pkgver-x86_64.deb::$url/releases/download/v$pkgver_gh/MotrixNext_${pkgver_gh}_amd64.deb"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
    local debfile="$pkgname-$pkgver-$CARCH.deb"
    ar x "$debfile" data.tar.gz
}

package() {
    tar -xf data.tar.gz -C "$pkgdir"
    sed -i '/^Categories=/c\Categories=Network;FileTransfer;' \
        "$pkgdir/usr/share/applications/MotrixNext.desktop"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
